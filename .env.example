# ===== Настройки бота LevelUp =====
# Скопируй этот файл в .env и заполни своими значениями

# Токен бота от @BotFather (никогда не коммить реальный токен!)
BOT_TOKEN=

# Строка подключения к PostgreSQL (asyncpg-драйвер)
# Формат: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://levelup:levelup@localhost:5432/levelup

# Telegram ID владельца(ев) бота через запятую (числа)
# Узнать свой ID: напиши @userinfobot
ADMIN_IDS=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
